Available when compiled with wide character string support:
.nf
.Ft int
.Fo libluksde_volume_open_wide
.Fa "libluksde_volume_t *volume"
.Fa "const wchar_t *filename"
.Fa "int access_flags"
.Fa "libluksde_error_t **error"
.Fc
.fi
