.Dd June 14, 2026
.Dt LIBLUKSDE 3
.Os
.Sh NAME
.Nm libluksde.h
.Nd Library to access the Linux Unified Key Setup (LUKS) Disk Encryption format
.Sh SYNOPSIS
.In libluksde.h
.Pp
Support functions
.nf
.Ft const char *
.Fo libluksde_get_version
.Fa "void"
.Fc
.fi
.nf
.Ft int
.Fo libluksde_get_access_flags_read
.Fa "void"
.Fc
.fi
.nf
.Ft int
.Fo libluksde_get_codepage
.Fa "int *codepage"
.Fa "libluksde_error_t **error"
.Fc
.fi
.nf
.Ft int
.Fo libluksde_set_codepage
.Fa "int codepage"
.Fa "libluksde_error_t **error"
.Fc
.fi
.nf
.Ft int
.Fo libluksde_check_volume_signature
.Fa "const char *filename"
.Fa "libluksde_error_t **error"
.Fc
.fi
.nf
.Ft int
.Fo libluksde_check_volume_signature_wide
.Fa "const wchar_t *filename"
.Fa "libluksde_error_t **error"
.Fc
.fi
.Pp
Available when compiled with libbfio support:
.nf
.Ft int
.Fo libluksde_check_volume_signature_file_io_handle
.Fa "libbfio_handle_t *file_io_handle"
.Fa "libluksde_error_t **error"
.Fc
.fi
.Pp
